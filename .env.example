# Folder for content.db and learner.db
EDUX_DATA_DIR=./data
HOST=127.0.0.1
PORT=8000
# Comma-separated hosts the server accepts, e.g. a tunnel host
ALLOWED_HOSTS=localhost,127.0.0.1
# Public address of the web pages, e.g. the tunnel's https URL; get_my_progress then returns a single-use map link
# (decision 0026). Leave unset for no link.
# EDUX_PUBLIC_BASE_URL=https://<your-tunnel-host>
