+def _clamp(p: float) -> float:
+    """p_known kept inside [0.001, 0.999]: BKT can round to exactly 1.0 after a long run of right answers, and the
+    exchange nudge works in odds, p / (1 - p)."""
+    return min(0.999, max(0.001, p))
