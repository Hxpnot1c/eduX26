--- a/scripts/check_mcp.py
+++ b/scripts/check_mcp.py
@@ -567,6 +567,9 @@ async def waiting_task(url: str) -> None:
     course check it displaced comes alone in the reply after, and the ignored re-ask is a skip (step 05e)."""
     student = "check-waiting"
     keyed = f"{url}?key={new_student(student)}"
+    # the prerequisite answered right before (a part never answered right reads at its prior, so an untouched
+    # prerequisite would get its own check first and take the slot this test is about)
+    learner.record_evidence(student, "ped_definition", "mcq_check", 1.0, apply="now")
     labels = {"question_depth": "surface", "engagement": "active", "request_type": "concept"}
 
     async def turn(message: str, extra: dict | None = None, **more) -> dict:
