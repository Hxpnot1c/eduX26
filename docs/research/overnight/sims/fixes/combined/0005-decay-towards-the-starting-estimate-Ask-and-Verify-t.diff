Date: Wed, 18 Nov 2026 02:36:51 +0000
Subject: [PATCH 5/5] decay towards the starting estimate (Ask and Verify
 towards 0); a part never answered right reads at most its starting estimate

---
 edux/learner.py      | 26 +++++++++++++++++++-------
 scripts/check_mcp.py |  3 +++
 2 files changed, 22 insertions(+), 7 deletions(-)

diff --git a/edux/learner.py b/edux/learner.py
index 7744be8..fc8d6d7 100644
--- a/edux/learner.py
+++ b/edux/learner.py
@@ -439,6 +439,12 @@ def difficulty(part_id: str) -> float:
     return base if cross is None else (1 - d.w_cross) * base + d.w_cross * cross
 
 
+def _floor(part_id: str) -> float:
+    """What stale evidence decays towards: the part's starting estimate, except on Ask and Verify (towards 0 there,
+    so a student who once passed the ritual doesn't stay near secure)."""
+    return 0.0 if part_id in (AIL_ASK, AIL_VERIFY) else initial_state(part_id)[0]
+
+
 def initial_state(part_id: str) -> tuple[float, float]:
     """Starting (p_known, half_life_days) for a part the student hasn't met, shifted by its difficulty."""
     s = _settings()
@@ -448,15 +454,17 @@ def initial_state(part_id: str) -> tuple[float, float]:
     return prior, half_life
 
 
-def p_now(p_known: float, half_life_days: float, since: datetime | str | None, now: datetime | str | None = None) -> float:
-    """p_known decayed by the time from since (the forgetting clock's start) to now.
+def p_now(p_known: float, half_life_days: float, since: datetime | str | None, now: datetime | str | None = None,
+          floor: float = 0.0) -> float:
+    """p_known decayed by the time from since (the forgetting clock's start) to now, towards floor (the part's
+    starting estimate: stale evidence counts for less, it doesn't make the part read below an untouched one).
 
     since is None until the student first gets the part right: with nothing learnt yet there is nothing to forget.
     """
     if since is None:
         return p_known
     days = max(0.0, (parse_ts(now or now_iso()) - parse_ts(since)).total_seconds() / 86400)
-    return p_known * 0.5 ** (days / half_life_days)
+    return floor + (p_known - floor) * 0.5 ** (days / half_life_days)
 
 
 def _load_state(conn: sqlite3.Connection, student_id: str, part_id: str, ts: str) -> dict:
@@ -484,7 +492,7 @@ def _save_state(conn: sqlite3.Connection, state: dict) -> None:
 
 
 def _p_at(state: dict, ts: str) -> float:
-    return p_now(state["p_known"], state["half_life_days"], state["clock_start"], ts)
+    return p_now(state["p_known"], state["half_life_days"], state["clock_start"], ts, _floor(state["part_id"]))
 
 
 def _queue_review(conn: sqlite3.Connection, student_id: str, part_id: str, due: datetime, reason: str,
@@ -757,12 +765,16 @@ def _apply_evidence(conn: sqlite3.Connection, student_id: str, part_id: str, evi
 
 
 def part_p(student_id: str, part_id: str, at: datetime | str | None = None) -> float:
-    """The student's current p_now on a part; a part they haven't met is at its starting estimate."""
+    """The student's current p_now on a part; a part they haven't met is at its starting estimate. A part never
+    answered right reads at most its starting estimate ("not yet shown"): talk and credit passed down from a
+    later part don't make it known."""
     part_id = graph.canonical(part_id)
+    prior = initial_state(part_id)[0]
     row = _conn().execute("SELECT * FROM part_state WHERE student_id = ? AND part_id = ?", (student_id, part_id)).fetchone()
     if row is None:
-        return initial_state(part_id)[0]
-    return p_now(row["p_known"], row["half_life_days"], row["clock_start"], at)
+        return prior
+    p = p_now(row["p_known"], row["half_life_days"], row["clock_start"], at, _floor(part_id))
+    return min(p, prior) if row["last_correct"] is None else p
 
 
 def level(p: float) -> str:
