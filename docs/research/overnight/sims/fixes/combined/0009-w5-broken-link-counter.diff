-def found_problem(kind: str = "ail_task", points_met: list[str] | None = None) -> dict:
-    """Verify evidence for a reported dead or mismatched source (step 05e): finding the problem is a successful
-    check, so it scores 1 whatever was ticked (a dead page has no publisher, date or figure to tick)."""
-    return {"part_id": AIL_VERIFY, "type": kind, "score": 1.0, "misconception_ids": [],
-            "points_met": list(points_met or [])}
+def found_problem(kind: str = "ail_task", points_met: list[str] | None = None) -> dict | None:
+    """Verify evidence for a reported dead or mismatched source (step 05e). The report itself counts as opening the
+    source and saying whether it matched (the first and last verify points); what else they say they found (who
+    published it and when, what the page shows) is ticked as usual. A bare report, with nothing ticked beyond
+    those two, is no evidence (None): it can't be told apart from a made-up one, so it must not pay more than a
+    real check."""
+    points = [p["id"] for p in graph.score_points(AIL_VERIFY)]
+    given = {graph.canonical(p) for p in points_met or []}
+    auto = {points[0], points[-1]}
+    if not given - auto:
+        return None
+    met = [p for p in points if p in given | auto]
+    return {"part_id": AIL_VERIFY, "type": kind, "score": len(met) / len(points), "misconception_ids": [],
+            "points_met": met}
 
 
