+def _stems(words: list[str]) -> dict[str, str]:
+    """Each word's stem under the index's porter tokenizer."""
+    mem = sqlite3.connect(":memory:")
+    try:
+        mem.execute("CREATE VIRTUAL TABLE t USING fts5(w, tokenize = 'porter')")
+        mem.execute("CREATE VIRTUAL TABLE v USING fts5vocab(t, 'instance')")
+        mem.executemany("INSERT INTO t (rowid, w) VALUES (?, ?)", list(enumerate(words)))
+        return {words[doc]: term for term, doc in mem.execute("SELECT term, doc FROM v")}
+    finally:
+        mem.close()
 
 
